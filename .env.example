# Infra (docker compose up -d)
# Postgres: localhost:5432 / adotei / postgres / postgres
# MinIO: http://localhost:9000 (minioadmin / minioadmin)

# Backend (mvn spring-boot:run)
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/adotei
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
S3_BUCKET=adotei-assets
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Frontend (npm run dev)
VITE_API_BASE_URL=http://localhost:8080

# Produção (Vercel + Railway)
# Deixe VITE_API_BASE_URL vazio na Vercel para usar same-origin (/api) com proxy.
# BACKEND_API_URL=https://seu-backend.up.railway.app
# APP_SECURITY_CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app
# APP_SECURITY_COOKIE_SAME_SITE=Lax
# APP_SECURITY_COOKIE_SECURE=true
